# 监听地址，格式为 ip:port，例如 :8080
LISTEN=127.0.0.1:8080

# 日志文件保存路径，默认放在数据目录下，随挂载目录一起持久化；留空时使用默认值
LOG=/var/lib/bepusdt/log/

# SQLite 数据库文件路径（使用 PostgreSQL 时可忽略）；留空时使用默认值
SQLITE=/var/lib/bepusdt/sqlite.db

# PostgreSQL 数据库
# POSTGRESQL_DSN=postgres://user:password@localhost:5432/bepusdt?sslmode=disable&connect_timeout=3&timezone=Asia/Shanghai

# HD 派生收款地址（仅 EVM），详见 docs/hd-wallet.md
# HD_MNEMONIC=
# HD_TRADE_TYPES=

# HD 归集：订单链上确认后，把派生地址里的 USDT 自动转到归集目标，详见 docs/hd-wallet.md
# 默认在配置了 HD_MNEMONIC 且 HD_TRADE_TYPES 含 usdt.bep20 时自动开启；填 false 可关闭
# HD_SWEEP_ENABLED=
# 归集目标地址，留空则转到助记词 m/44'/60'/0'/0/0（钱包里的第一个账户），该地址同时用来垫付手续费，需预留 BNB
# HD_COLLECT_ADDRESS=
# 单次给收款地址补充手续费的 BNB 上限，例如填小数；留空不限制
# HD_SWEEP_GAS_BNB=
